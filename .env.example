# Environment Configuration Example
# Copy to .env.local for development. Never commit real secrets to source control.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
DEFAULT_LOCALE=en-IN

# Database & Supabase Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kerala_rentals
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon_placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role_placeholder
DATABASE_USE_EMBEDDED=true

# Auth Secrets
JWT_SECRET=super-secure-dev-jwt-secret-replace-in-production-min-32-chars-long
SESSION_EXPIRY_HOURS=24

# Payment Provider (Razorpay / Mock)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# WhatsApp Business API (Cloud API / Mock)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_token
WHATSAPP_VERIFY_TOKEN=kerala_rental_wa_verify_token_dev
WHATSAPP_WEBHOOK_SECRET=placeholder_wa_webhook_secret

# Identity Verification Provider
IDENTITY_VERIFICATION_PROVIDER=mock
IDENTITY_VERIFICATION_API_KEY=placeholder_id_provider_key

# Transactional SMS & Email
SMS_PROVIDER=mock
SMS_API_KEY=placeholder_sms_key
EMAIL_PROVIDER=mock
EMAIL_API_KEY=placeholder_email_key

# Object Storage (Supabase Storage / S3 / Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET_PUBLIC_PHOTOS=public_vehicle_photos
STORAGE_BUCKET_PRIVATE_ID=private_identity_documents
STORAGE_BUCKET_PRIVATE_VEHICLE_DOCS=private_vehicle_documents
STORAGE_BUCKET_PRIVATE_INSPECTIONS=private_inspection_media
STORAGE_BUCKET_PRIVATE_SUPPORT=private_support_attachments

# Feature Flags
FEATURE_RENTALS_ENABLED=true
FEATURE_USED_SALES_ENABLED=false
FEATURE_PAYMENTS_ENABLED=true
FEATURE_WHATSAPP_ENABLED=true
FEATURE_IDENTITY_VERIFICATION_ENABLED=true
FEATURE_MALAYALAM_ENABLED=true
FEATURE_INSTANT_BOOK=false
